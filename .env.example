# Copy this file to .env and fill in real values:  cp .env.example .env
# docker-compose passes these into the backend container.

# Anthropic Claude API key (required for Jira/AI intent extraction & validation)
ANTHROPIC_API_KEY=

# Jira connection (required only when reconciling with a --jira ticket)
JIRA_URL=https://your-org.atlassian.net
JIRA_EMAIL=you@your-org.com
JIRA_API_TOKEN=
